NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy public key fallback only:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy elevated key fallback only:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Phase 3 server-only OpenAI Evidence extraction
OPENAI_API_KEY=replace_me
OPENAI_EVIDENCE_MODEL=gpt-5-mini-2025-08-07
OPENAI_EVIDENCE_TIMEOUT_MS=60000

# Phase 4 server-only OpenAI Problem Candidate grouping
# Falls back to OPENAI_EVIDENCE_MODEL/TIMEOUT when omitted.
OPENAI_CANDIDATE_MODEL=gpt-5-mini-2025-08-07
OPENAI_CANDIDATE_TIMEOUT_MS=60000

# Phase 7.2 server-only grounded Idea Candidate generation
# Falls back to Candidate/Evidence model and timeout when omitted.
OPENAI_IDEA_MODEL=gpt-5-mini-2025-08-07
OPENAI_IDEA_TIMEOUT_MS=60000

# Phase 15.4 server-only Threads official keyword search adapter.
# The token must authorize the threads_keyword_search scope.
THREADS_ACCESS_TOKEN=replace_me
# Optional override; defaults to https://graph.threads.net
# THREADS_API_HOST=https://graph.threads.net

# Phase 15.5B server-only NAVER API HUB Search credentials.
# Subscribe to NAVER API HUB and register an Application with Search API enabled.
# Runtime maps these values to X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY.
NAVER_CLIENT_ID=replace_me
NAVER_CLIENT_SECRET=replace_me

# Phase 15.5 legacy/experimental Complaint Relevance classifier.
# Phase 15.5E active source admission is deterministic and does not call an LLM.
OPENAI_COMPLAINT_MODEL=gpt-5-mini-2025-08-07
OPENAI_COMPLAINT_TIMEOUT_MS=60000
# Paid Silver execution is hard-disabled unless this is explicitly set to true.
ALLOW_PAID_SILVER_LLM=false
